# Secrets only. Which model and provider each stage uses is chosen in config.yaml.

# --- Required -------------------------------------------------------------
# Free key: https://console.groq.com/keys. The default config.yaml runs every LLM stage on Groq.
GROQ_API_KEY=

# Postgres + pgvector. Matches docker-compose.yml (use port 5433 if you remapped it there).
# Any script's --db_url flag overrides this.
DB_URL=postgresql://rag_user:admin@localhost:5432/ragdb

# --- Optional: keys for other providers declared in config.yaml -------------
# Free key: https://aistudio.google.com/apikey (used if a stage sets provider: gemini)
# GEMINI_API_KEY=
