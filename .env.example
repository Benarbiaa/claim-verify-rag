# --- Required -------------------------------------------------------------
# Free key: https://console.groq.com/keys. With only this set, every role runs on Groq.
GROQ_API_KEY=

# --- Optional: one model per pipeline role (see src/claimverify/llm.py) ----
# Defaults if left empty:
#   draft, decompose -> openai/gpt-oss-120b      (Groq)
#   verify           -> llama-3.3-70b-versatile  (Groq, different model family on purpose)
DRAFT_MODEL=
DECOMPOSE_MODEL=
VERIFY_MODEL=

# Any role can point to another OpenAI-compatible provider. Set its BASE_URL *and* its
# API_KEY: the Groq key is never sent to a non-Groq URL.
# Example: run the verifier locally with Ollama (no key needed; any non-empty value works)
# VERIFY_BASE_URL=http://localhost:11434/v1
# VERIFY_API_KEY=ollama
# VERIFY_MODEL=qwen2.5:14b
